#!/usr/bin/env bash
#
# Roda as verificações do vault antes de cada commit.
#
# Ativar (uma vez por clone):
#   git config core.hooksPath .githooks
#
# Pular pontualmente:  git commit --no-verify

set -uo pipefail

RAIZ="$(git rev-parse --show-toplevel)"
cd "$RAIZ"

# python3 pode existir só como stub inválido (ex.: alias da Microsoft Store no
# Windows sem Python real registrado) — nesse caso cai para "python".
PY=python3
if ! "$PY" -c "" >/dev/null 2>&1; then
  PY=python
fi

falhou=0

echo "→ validando o vault"
if ! "$PY" ./scripts/validar-vault.py; then
  falhou=1
fi

echo
echo "→ verificando os índices"
if ! "$PY" ./scripts/gerar-indices.py --check; then
  echo
  echo "índice desatualizado. Rode:"
  echo "    ./scripts/gerar-indices.py && git add -u"
  falhou=1
fi

if [[ $falhou -ne 0 ]]; then
  echo
  echo "commit bloqueado. Corrija o que está acima, ou use --no-verify se souber o que está fazendo."
  exit 1
fi

echo
echo "vault ok"
